@page
@model IndexModel
@{
    ViewData["Title"] = "Qwen Chat";
}

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">Qwen Chat</div>
        <button id="newChatBtn" class="new-chat-btn" type="button">+ New chat</button>
        <p class="hint">Connected to local Python API</p>
    </aside>

    <main class="chat-main">
        <header class="chat-header">
            <h1>Ask Qwen</h1>
            <span class="status" id="statusText">Ready</span>
        </header>

        <section id="chatLog" class="chat-log" aria-live="polite"></section>

        <form id="chatForm" class="composer" autocomplete="off">
            <textarea id="messageInput" rows="1" placeholder="Message Qwen..." required></textarea>
            <button id="sendBtn" type="submit">Send</button>
        </form>
    </main>
</div>
